# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings > Database
# Use the direct connection string (port 5432) for local dev and migrations.
# For serverless/edge deployments, use the transaction pooler (port 6543)
# connection string instead - db/client.ts already sets prepare:false for it.
DATABASE_URL=
