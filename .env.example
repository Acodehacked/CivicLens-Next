# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: safe for the browser, replaces the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, replaces the legacy "service_role" key. Bypasses
# RLS - never prefix with NEXT_PUBLIC_, never send to the browser. Only
# used by lib/supabase/admin.ts for trusted, RLS-bypassing operations.
SUPABASE_SECRET_KEY=

# Absolute origin used to build the Google OAuth redirect URL (e.g.
# https://civiclens.example.com). Falls back to the request's Host header
# in local dev if unset - set this explicitly in production.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings > Database
# Direct/session connection (port 5432) - used only by drizzle-kit
# push/migrate for DDL. Never used at app runtime.
DATABASE_URL=
# Transaction-mode pooler (port 6543, same host/credentials as above,
# different port) - used by db/client.ts for all app runtime queries.
# Required: using DATABASE_URL (session mode) at runtime exhausts
# Supabase's session pool_size almost immediately under concurrent load.
DATABASE_POOL_URL=

RESEND_API_KEY=
NEXT_PUBLIC_GROQ_API=
